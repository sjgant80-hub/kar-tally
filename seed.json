{
  "genome": "1",
  "name": "kar-tally",
  "kind": "tool",
  "purpose": "Recomputes an AI agent's spend log from its budget cap and proves the claimed balances add up, no entry is missing and the cap was never exceeded, with no AI judge.",
  "lane": {
    "id": "spend-log-audit",
    "accepts": "a spend log: a budget cap, a starting sequence number and a non-empty list of entries, each with its cost and claimed running balance",
    "refuses": "anything that is not a spend log, such as a question, a bill in prose or a request to pay or move money"
  },
  "interface": {
    "in": "{\"cap\":<number>,\"startSeq\":<integer>,\"entries\":[{\"seq\",\"actor\",\"action\",\"cost\",\"balance\"}]}",
    "out": "a verdict, PASS or FAIL, naming every violation, with each entry's recomputed balance"
  },
  "judge": {
    "what": "a spend log is right when Kar-Tally's own recompute finds every claimed balance equal to the cap minus the costs so far, no gap in the sequence, and the cap never exceeded",
    "run": "node genome/judge.mjs",
    "cases": {
      "good": {
        "cap": 500,
        "startSeq": 1,
        "entries": [
          {
            "seq": 1,
            "actor": "agent-1",
            "action": "api_call:search",
            "cost": 40,
            "balance": 460
          },
          {
            "seq": 2,
            "actor": "agent-1",
            "action": "api_call:generate",
            "cost": 75.5,
            "balance": 384.5
          },
          {
            "seq": 3,
            "actor": "agent-2",
            "action": "tool:send_email",
            "cost": 12.25,
            "balance": 372.25
          },
          {
            "seq": 4,
            "actor": "agent-1",
            "action": "api_call:generate",
            "cost": 88,
            "balance": 284.25
          },
          {
            "seq": 5,
            "actor": "agent-3",
            "action": "tool:file_write",
            "cost": 5,
            "balance": 279.25
          },
          {
            "seq": 6,
            "actor": "agent-2",
            "action": "api_call:search",
            "cost": 40,
            "balance": 239.25
          }
        ]
      },
      "bad": {
        "cap": 500,
        "startSeq": 1,
        "entries": [
          {
            "seq": 1,
            "actor": "agent-1",
            "action": "api_call:search",
            "cost": 40,
            "balance": 460
          },
          {
            "seq": 2,
            "actor": "agent-1",
            "action": "api_call:generate",
            "cost": 75.5,
            "balance": 384.5
          },
          {
            "seq": 3,
            "actor": "agent-2",
            "action": "tool:send_email",
            "cost": 12.25,
            "balance": 372.25
          },
          {
            "seq": 4,
            "actor": "agent-1",
            "action": "api_call:generate",
            "cost": 400,
            "balance": 20
          },
          {
            "seq": 5,
            "actor": "agent-3",
            "action": "tool:file_write",
            "cost": 5,
            "balance": 279.25
          },
          {
            "seq": 6,
            "actor": "agent-2",
            "action": "api_call:search",
            "cost": 40,
            "balance": 239.25
          }
        ]
      }
    }
  },
  "boundary": {
    "run": "node genome/lane.mjs",
    "inLane": {
      "cap": 500,
      "startSeq": 1,
      "entries": [
        {
          "seq": 1,
          "actor": "agent-1",
          "action": "api_call:search",
          "cost": 40,
          "balance": 460
        },
        {
          "seq": 2,
